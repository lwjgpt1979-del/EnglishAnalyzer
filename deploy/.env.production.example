# deploy/.env.production.example
# Template for /opt/enggramer/.env on the production server.
# Copy this file to the server as /opt/enggramer/.env and fill in real values.
# NEVER commit the real .env to git.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# Use container hostname 'postgres' (Docker internal network)
DATABASE_URL=postgresql+psycopg://enggramer:CHANGE_ME_strong_random_password@postgres:5432/enggramer
ASYNC_DATABASE_URL=postgresql+psycopg_async://enggramer:CHANGE_ME_strong_random_password@postgres:5432/enggramer

# ── WeChat Mini Program ───────────────────────────────────────────────────────
# From: WeChat Public Platform → Development → Dev Settings
WECHAT_APPID=wxYOUR_APPID_HERE
WECHAT_APPSECRET=YOUR_32_CHAR_APPSECRET_HERE

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_random_64_char_string

# ── DeepSeek（OpenAI 兼容协议）─────────────────────────────────────────────
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY_HERE

# ── 阿里云 OCR（印刷体）─────────────────────────────────────────────────────
ALIYUN_OCR_ACCESS_KEY_ID=AKID_YOUR_ALIYUN_ACCESS_KEY
ALIYUN_OCR_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET

# ── 腾讯云 OCR（手写体）─────────────────────────────────────────────────────
TENCENT_OCR_SECRET_ID=YOUR_TENCENT_SECRET_ID
TENCENT_OCR_SECRET_KEY=YOUR_TENCENT_SECRET_KEY

# ── Tencent COS (Cloud Object Storage) ───────────────────────────────────────
# From: Tencent Cloud CAM → API Key Management
COS_SECRET_ID=AKIDYOUR_SECRET_ID_HERE
COS_SECRET_KEY=YOUR_SECRET_KEY_HERE
# Bucket format: <name>-<appid>  e.g. enggramer-prod-1258000001
COS_BUCKET=enggramer-prod-YOUR_APPID
COS_REGION=ap-guangzhou
COS_BASE_URL=https://enggramer-prod-YOUR_APPID.cos.ap-guangzhou.myqcloud.com

# ── WeChat Pay v3 (optional for MVP, can use placeholder values initially) ────
WECHAT_PAY_MCH_ID=YOUR_MCH_ID
WECHAT_PAY_API_KEY_V3=YOUR_32_CHAR_API_KEY_V3
WECHAT_PAY_CERT_SERIAL=YOUR_CERT_SERIAL_NUMBER
# Write the PEM key as a single line with literal \n between lines
WECHAT_PAY_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nYOUR_BASE64_KEY\n-----END PRIVATE KEY-----
WECHAT_PAY_NOTIFY_URL=https://api.goodgrammar.top/api/v1/webhooks/wx-pay
# Set to false in production to enforce signature verification
WECHAT_PAY_SKIP_SIG_VERIFY=false

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
