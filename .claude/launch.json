{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && exec /opt/anaconda3/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend/admin", "run", "dev"],
      "port": 5174
    },
    {
      "name": "institution",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend/institution", "run", "dev"],
      "port": 5175
    },
    {
      "name": "miniprogram",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend/miniprogram", "run", "dev:h5"],
      "port": 5173
    }
  ]
}
